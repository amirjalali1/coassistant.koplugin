#: koassistant/prompts/actions.lua:2375
#, fuzzy
msgid ""
"Analyzes what the collection reveals about the reader's interests, perspective, and what might be missing for a more complete picture."
msgstr "Анализирует, что коллекция раскрывает об интересах, перспективе читателя и чего может не хватать для более полной картины."

#: koassistant/prompts/actions.lua:2387
#, fuzzy
msgid "Quick Summaries"
