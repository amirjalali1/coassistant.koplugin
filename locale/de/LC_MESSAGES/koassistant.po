msgstr "Markdown-Syntax in lesbaren einfachen Text konvertieren (Überschriften, Listen usw.). Deaktivieren, um rohes Markdown anzuzeigen."

#: koassistant/ui/settings_schema.lua:296
#, fuzzy
msgid "Text Mode for Dictionary"
msgstr "Textmodus für Wörterbuch"

#: koassistant/ui/settings_schema.lua:299
#, fuzzy
msgid ""
"Use Plain Text mode for dictionary popup. Better font support for non-Latin scripts."
msgstr "Einfacher Textmodus für Wörterbuch-Popup verwenden. Bessere Schriftunterstützung für nicht-lateinische Schriften."

#: koassistant/ui/settings_schema.lua:304
#, fuzzy
msgid "Text Mode for RTL Dictionary"
