#: koassistant_settings_schema.lua:1997
msgid "Preset: Full"
msgstr ""

#: koassistant_settings_schema.lua:1998
msgid ""
"Enable all data sharing for full functionality. Does not enable text "
"extraction (see Text Extraction submenu)."
